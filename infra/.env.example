# Local development settings. Copy to infra/.env (scripts/infra-env.sh does this) and keep infra/.env out of git.
# Every value below is an invented dev-only placeholder for a laptop stack. Never reuse it anywhere else.
#
# These values only take effect on a NEW data volume. A volume created earlier keeps the passwords it was created
# with. For an existing local stack, put its own values into infra/.env, or start clean.

# --- MariaDB (compose: mariadb; init script: mariadb/init/01-create-databases.sh) ---
# Password of the MariaDB root user.
MYSQL_ROOT_PASSWORD=dev-only-mariadb-root-change-me
# Password of the application user `udan` (the Server connects with it; also used by the health check).
UDAN_DB_PASSWORD=dev-only-udan-db-change-me

# --- PostgreSQL (compose: postgres; init script: postgres/init/01-create-keycloak-db.sh) ---
# Superuser created by the image on first start.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-only-postgres-change-me

# --- Keycloak (compose: keycloak) ---
# Bootstrap admin of the master realm.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin-change-me
# Database user Keycloak uses in PostgreSQL. The Postgres init script creates it with this password.
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=dev-only-keycloak-db-change-me
# Dev-only client secret of backend-service in realms UDAN and UDAN-Plugin.
# Must equal the secret in infra/keycloak/realms/*.json (scripts/check-realms.sh checks this).
KC_BACKEND_SERVICE_SECRET=dev-only-backend-service-secret-change-me
