# Keep LF in the repository and in every checkout, so the bash scripts (./udan,
# scripts/*.sh, infra/**/*.sh) run on Linux, WSL and Windows alike. This matches
# .editorconfig (end_of_line = lf) and overrides a global core.autocrlf=true.
* text=auto eol=lf

# Windows launchers keep CRLF, which cmd.exe expects.
*.cmd text eol=crlf
*.bat text eol=crlf
